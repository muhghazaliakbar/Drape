{
  "sourceLanguage": "en",
  "strings": {
    "%@ is Blocked": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Diblokir"
          }
        }
      }
    },
    "%@ is blocked": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diblokir"
          }
        }
      }
    },
    "%lld apps will be hidden when Present Mode is on.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld aplikasi akan disembunyikan saat Present Mode aktif."
          }
        }
      }
    },
    "%lld protections active": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld proteksi aktif"
          }
        }
      }
    },
    "1 app will be hidden when Present Mode is on.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1 aplikasi akan disembunyikan saat Present Mode aktif."
          }
        }
      }
    },
    "1 protection active": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1 proteksi aktif"
          }
        }
      }
    },
    "A brief glow and a card when Present Mode switches. Hidden from screen capture.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilatan singkat dan kartu saat Present Mode berganti. Tidak ikut terekam layar."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentang"
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi"
          }
        }
      }
    },
    "Choose a Shortcut in Settings.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sebuah Shortcut di Pengaturan."
          }
        }
      }
    },
    "Clear search": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus pencarian"
          }
        }
      }
    },
    "Clear the desktop": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersihkan desktop"
          }
        }
      }
    },
    "Cover the notification corner": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup sudut notifikasi"
          }
        }
      }
    },
    "Deselect All": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan Semua"
          }
        }
      }
    },
    "Developer": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengembang"
          }
        }
      }
    },
    "Everything restored": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya dipulihkan"
          }
        }
      }
    },
    "GitHub": {
      "shouldTranslate": false
    },
    "Hidden when presenting": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disembunyikan saat presentasi"
          }
        }
      }
    },
    "Hide sensitive apps": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan aplikasi sensitif"
          }
        }
      }
    },
    "Hides banners as they appear, on every display.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menutupi banner begitu muncul, di semua layar."
          }
        }
      }
    },
    "Hides desktop icons. Restarts Finder, so windows will flicker.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyembunyikan ikon desktop. Finder dimulai ulang, jadi jendela akan berkedip."
          }
        }
      }
    },
    "Hides the apps you choose, and brings them back afterwards.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyembunyikan aplikasi pilihan Anda, lalu mengembalikannya."
          }
        }
      }
    },
    "Idle": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaga"
          }
        }
      }
    },
    "If the shortcut does nothing, another app claimed it first. macOS does not report that conflict, so the only fix is a different combination.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika pintasan ini tidak berfungsi, aplikasi lain sudah mengklaimnya lebih dulu. macOS tidak melaporkan konflik itu, jadi satu-satunya solusi adalah kombinasi lain."
          }
        }
      }
    },
    "Include ⌘, ⌥ or ⌃.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertakan ⌘, ⌥, atau ⌃."
          }
        }
      }
    },
    "Installed apps": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi terpasang"
          }
        }
      }
    },
    "Keep them hidden": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan tersembunyi"
          }
        }
      }
    },
    "Licence": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisensi"
          }
        }
      }
    },
    "Looking for installed apps…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari aplikasi terpasang…"
          }
        }
      }
    },
    "MIT": {
      "shouldTranslate": false
    },
    "No Shortcuts found. Create two in the Shortcuts app using the “Set Focus” action — one that turns a Focus on, one that turns it off.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada Shortcut ditemukan. Buat dua di aplikasi Shortcuts dengan aksi “Set Focus” — satu untuk menyalakan Focus, satu untuk mematikannya."
          }
        }
      }
    },
    "No apps will be hidden yet.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada aplikasi yang akan disembunyikan."
          }
        }
      }
    },
    "None": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada"
          }
        }
      }
    },
    "Notification hidden": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi disembunyikan"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mati"
          }
        }
      }
    },
    "One shortcut, pressed three seconds before you share your screen.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu pintasan, ditekan tiga detik sebelum Anda membagikan layar."
          }
        }
      }
    },
    "Other apps": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi lain"
          }
        }
      }
    },
    "Pick at least one app in Settings.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih setidaknya satu aplikasi di Pengaturan."
          }
        }
      }
    },
    "Present Mode off": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Present Mode mati"
          }
        }
      }
    },
    "Present Mode on": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Present Mode aktif"
          }
        }
      }
    },
    "PresentSafe": {
      "shouldTranslate": false
    },
    "PresentSafe is hiding it while you present.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PresentSafe menyembunyikannya selama Anda presentasi."
          }
        }
      }
    },
    "Protecting your screen": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melindungi layar Anda"
          }
        }
      }
    },
    "Protections": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteksi"
          }
        }
      }
    },
    "Puts an app back if you open it while Present Mode is on.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan aplikasi jika Anda membukanya saat Present Mode aktif."
          }
        }
      }
    },
    "Quit PresentSafe": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dari PresentSafe"
          }
        }
      }
    },
    "Report an Issue": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporkan Masalah"
          }
        }
      }
    },
    "Runs a Shortcut, the only supported way to silence notifications.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjalankan Shortcut, satu-satunya cara resmi membisukan notifikasi."
          }
        }
      }
    },
    "Search apps": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari aplikasi"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan…"
          }
        }
      }
    },
    "Shortcut": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan"
          }
        }
      }
    },
    "Show on-screen confirmation": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan konfirmasi di layar"
          }
        }
      }
    },
    "Snooze": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunda"
          }
        }
      }
    },
    "Snooze for 3 minutes": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunda 3 menit"
          }
        }
      }
    },
    "Snooze to use it for 3 minutes": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunda untuk memakainya 3 menit"
          }
        }
      }
    },
    "Source Code": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode Sumber"
          }
        }
      }
    },
    "That would take %@ away from every app.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu akan mengambil %@ dari semua aplikasi."
          }
        }
      }
    },
    "This shortcut is already registered. Try a different one.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan ini sudah terdaftar. Coba kombinasi lain."
          }
        }
      }
    },
    "Toggle Present Mode": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alihkan Present Mode"
          }
        }
      }
    },
    "Turn Off Present Mode": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan Present Mode"
          }
        }
      }
    },
    "Turn On Present Mode": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Present Mode"
          }
        }
      }
    },
    "Turn on a Focus": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Focus"
          }
        }
      }
    },
    "Type a shortcut": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik pintasan"
          }
        }
      }
    },
    "Version %@ (%@)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi %@ (%@)"
          }
        }
      }
    },
    "Website": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Situs web"
          }
        }
      }
    },
    "When Present Mode is on": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Present Mode aktif"
          }
        }
      }
    },
    "could not run %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tidak bisa menjalankan %@"
          }
        }
      }
    },
    "justghali.dev": {
      "shouldTranslate": false
    },
    "macOS refused the request: %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS menolak permintaan: %@"
          }
        }
      }
    },
    "macOS refused to register this shortcut (error %d).": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS menolak mendaftarkan pintasan ini (galat %d)."
          }
        }
      }
    },
    "the Shortcut “%@” did not run": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut “%@” tidak berjalan"
          }
        }
      }
    },
    "© 2026 Muh Ghazali Akbar. Open source, and free to use and modify.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Muh Ghazali Akbar. Sumber terbuka, bebas digunakan dan dimodifikasi."
          }
        }
      }
    },
    "⎋ cancel · ⌫ reset": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⎋ batal · ⌫ atur ulang"
          }
        }
      }
    }
  },
  "version": "1.0"
}
